<Window x:Class="AppCAT.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppCAT" Height="680" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
      
        <Border x:Name="WelcomeScreen" Visibility="Visible"
                Style="{StaticResource CardBorder}"
                Margin="30">
            <StackPanel>
               
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,28">
                    <TextBlock Text="☁" FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="AppCAT"
                               FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,4"/>
                    <TextBlock Text="Azure Migrate Application &amp; Code Assessment"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

               
                <Separator Margin="0,0,0,24" Background="#E0E0E0"/>

                
                <TextBlock Text="Select Migration type:"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

               
                <Border x:Name="DotNetCard"
                        Background="White" CornerRadius="6"
                        BorderBrush="#D0E8FF" BorderThickness="2"
                        Margin="0,0,0,12" Cursor="Hand"
                        MouseLeftButtonUp="DotNetCard_Click"
                        MouseEnter="DotNetCard_MouseEnter"
                        MouseLeave="DotNetCard_MouseLeave"
                        Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.06" BlurRadius="8" ShadowDepth="1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text=".NET Application"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="For .NET / C# applications"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›"
                                   FontSize="20" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>

            
                <Border x:Name="JavaCard"
                        Background="White" CornerRadius="6"
                        BorderBrush="#D0E8FF" BorderThickness="2"
                        Cursor="Hand"
                        MouseLeftButtonUp="JavaCard_Click"
                        MouseEnter="JavaCard_MouseEnter"
                        MouseLeave="JavaCard_MouseLeave"
                        Padding="16,14">
                    <Border.Effect>
                        <DropShadowEffect Opacity="0.06" BlurRadius="8" ShadowDepth="1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                       
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Java Application"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="For Java / Maven / Gradle applications"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="›"
                                   FontSize="20" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Internet connection required for installation."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

       
        <Border x:Name="InstallingScreen" Visibility="Collapsed"
                Style="{StaticResource CardBorder}"
                Margin="30">
            <StackPanel>
               
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,28">
                    
                    <TextBlock x:Name="InstallTitleText"
                               Text="Installing AppCAT..."
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,4"/>
                    <TextBlock x:Name="InstallSubtitleText"
                               Text="Please wait while we set up AppCAT on your system"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

               
                <Grid Margin="0,0,0,10">
                    <ProgressBar x:Name="InstallProgressBar"
                                 Height="8" Minimum="0" Maximum="100" Value="0"
                                 Background="#E8E8E8"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                </Grid>

            
                <TextBlock x:Name="ProgressPercentText"
                           Text="0%"
                           FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,20"/>

               
                <Border Background="#F8F8F8" CornerRadius="4"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="12" Height="160">
                    <ScrollViewer x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

             
                <StackPanel x:Name="ActionButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="BackButton"
                            Content="Back"
                            Style="{StaticResource SecondaryButton}"
                            Width="140" Margin="0,0,12,0"
                            Click="BackButton_Click"/>
                    <Button x:Name="ScanAppButton"
                            Content="Scan"
                            Style="{StaticResource PrimaryButton}"
                            Width="140"
                            Click="ScanAppButton_Click"/>
                </StackPanel>

                
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Width="140"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
        <Frame x:Name="MainFrame" 
           NavigationUIVisibility="Hidden" 
           Visibility="Collapsed"/>
    </Grid>
</Window>
